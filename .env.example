# Copiar este archivo como .env y completar. El .env NUNCA se sube a GitHub.

# Neon: proyecto bd_delicia_crm > Connect > rama production > copiar la cadena
DATABASE_URL=postgresql://USUARIO:CLAVE@HOST.neon.tech/neondb?sslmode=require

# Clave para firmar los tokens. Generar una larga, por ejemplo:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cambiar_por_una_clave_larga_y_aleatoria
JWT_EXPIRA=8h

# Puerto: el app Android ya usa 8000 en BASE_URL
PORT=8000

# Banco Andino: clave que el banco envia en el header x-banco-firma al confirmar pagos
BANCO_WEBHOOK_SECRET=cambiar_por_otra_clave_larga

# Webs que pueden llamar a la API (separadas por coma)
CORS_ORIGINS=http://localhost:5173,https://www.deliciapasteleria.online